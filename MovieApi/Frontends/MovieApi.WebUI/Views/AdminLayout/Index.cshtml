@using MovieApi.WebUI.ViewComponents.AdminLayoutViewComponents

@{
  Layout = null;
}
<!doctype html>
<html lang="en">
@await Component.InvokeAsync(nameof(_AdminLayoutHeadComponentPartial))
<body>


<div class="wrapper">
  @await Component.InvokeAsync(nameof(_AdminLayoutSidebarComponentPartial))


  @await Component.InvokeAsync(nameof(_AdminLayoutHeaderComponentPartial))

  <div class="page-content-wrapper">

    <div class="page-content">


      @await Component.InvokeAsync(nameof(_AdminLayoutBreadCrumbComponentPartial))
   
      @RenderBody()
      
    </div>

  </div>

  @await Component.InvokeAsync(nameof(_AdminLayoutSwitcherComponentPartial))

</div>

@await Component.InvokeAsync(nameof(_AdminLayoutScriptsComponentPartial))

</body>
</html>